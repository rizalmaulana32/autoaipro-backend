# Server
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/autoaipro

# JWT Secret - change this in production!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin Setup Key - used for POST /api/auth/setup-admin
ADMIN_SETUP_KEY=SETUP_ADMIN_2026

# File Storage
# Options: local, s3, supabase
STORAGE_PROVIDER=local
MAX_FILE_SIZE=10485760

# Local Storage (when STORAGE_PROVIDER=local)
STORAGE_PATH=./storage

# AWS S3 (when STORAGE_PROVIDER=s3)
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BASE_FOLDER=autoaipro

# Supabase (when STORAGE_PROVIDER=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=properties
SUPABASE_BASE_FOLDER=autoaipro

# CORS - add your chrome extension ID and frontend URLs
ALLOWED_ORIGINS=chrome-extension://your-extension-id,http://localhost:3000,http://localhost:5173
