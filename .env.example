# Server Configuration
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/autoaipro

# JWT Secret (Generate a random string for production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# File Storage Configuration
# Storage provider: local, s3, or supabase
STORAGE_PROVIDER=local

# Maximum file size in bytes (10MB default)
MAX_FILE_SIZE=10485760

# Local Storage Settings (used when STORAGE_PROVIDER=local)
STORAGE_PATH=./storage

# AWS S3 Storage Settings (used when STORAGE_PROVIDER=s3)
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BASE_FOLDER=autoaipro

# Supabase Storage Settings (used when STORAGE_PROVIDER=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=properties
SUPABASE_BASE_FOLDER=autoaipro

# CORS - Add your Chrome extension ID here
ALLOWED_ORIGINS=chrome-extension://your-extension-id-here,http://localhost:3000,https://system.reins.jp
